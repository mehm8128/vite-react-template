    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^1.0.0",
    "@markuplint/jsx-parser": "^4.7.22",
    "@markuplint/react-spec": "^4.5.22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "markuplint": "^4.14.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.43.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
}
